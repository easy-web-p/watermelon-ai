# คัดลอกเป็น .env.oci บน VM เท่านั้น ห้าม commit ไฟล์จริง
PUBLIC_HOST="watermelon-203-0-113-10.sslip.io"
APP_URL="https://watermelon-203-0-113-10.sslip.io"
ALLOWED_ORIGINS="https://watermelon-203-0-113-10.sslip.io,https://acoustic-fruit-ripeness.web.app,https://localhost,capacitor://localhost"

# bootstrap.sh สุ่มสองค่านี้แยกกันบน VM
JWT_SECRET=""
STORAGE_SECRET=""

LOCAL_CHAT_MODEL="qwen3.5:4b"

# โมเดลที่เสียเงินปิดอยู่ การมีคีย์ในเครื่องอื่นจะไม่ถูกส่งขึ้น VM
CHAT_ENABLE_GEMINI="0"
VISION_ENABLE_CLAUDE="0"
