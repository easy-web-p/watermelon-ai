{$PUBLIC_HOST} {
  encode zstd gzip

  reverse_proxy api:3000 {
    transport http {
      dial_timeout 10s
      response_header_timeout 300s
    }
  }

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
