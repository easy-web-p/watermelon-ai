# ─── AI ───────────────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls from server.ts.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Where this app is hosted. Used for self-referential links,
# OAuth callbacks and API endpoints.
APP_URL="MY_APP_URL"

# ─── Frontend ─────────────────────────────────────────────────────────
# VITE_API_BASE_URL: Origin of the REST API.
#
# Leave EMPTY for web builds — the client then uses relative URLs, which the
# Vite dev proxy and the Express server (which serves dist/) both resolve.
#
# REQUIRED for Capacitor Android/iOS builds: the WebView origin is
# `https://localhost`, so a relative /api/v1 would never reach your server.
# Set it to the deployed API, e.g. https://api.watermelon.ai
VITE_API_BASE_URL=""

# API_PROXY_TARGET: Where `npm run dev:web` forwards /api during development.
# Defaults to http://localhost:3000 (the port `npm run dev` listens on).
API_PROXY_TARGET="http://localhost:3000"

# ─── Firebase App Check & reCAPTCHA Enterprise ───────────────────────
# VITE_RECAPTCHA_ENTERPRISE_KEY: The reCAPTCHA Enterprise site key generated in Google Cloud Console.
VITE_RECAPTCHA_ENTERPRISE_KEY=""
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN: (Optional) Custom static debug token for local dev/CI.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# ─── Security & Backend Auth ──────────────────────────────────────────
#
# With NODE_ENV=production, the server REFUSES TO START unless both
# JWT_SECRET and STORAGE_SECRET are set. The development fallbacks are
# committed to this repository, so running production on them means anyone
# who can read the source can mint an admin session and sign a read URL for
# any uploaded file.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# JWT_SECRET: Signs and verifies the RFC 7519 HMAC-SHA256 session tokens.
# Every request's identity and role is read from this signature alone.
# Changing it signs every existing user out.
JWT_SECRET="watermelon_change_this_to_a_random_32_byte_secret_in_production"

# STORAGE_SECRET: Signs the pre-signed media URLs that serve uploads/.
# Keep it distinct from JWT_SECRET so rotating one does not invalidate the
# other. Changing it invalidates every media URL already handed out.
STORAGE_SECRET="watermelon_change_this_to_a_different_random_secret_in_production"

# TRUST_PROXY: Set to "true" ONLY when the server sits behind a reverse
# proxy or load balancer that sets X-Forwarded-For (Cloud Run, nginx, an
# ingress). The OTP and login rate limits key on the client IP; with this
# off, that header is ignored, because a client that can set it freely can
# give itself an unlimited number of OTP attempts. With it on and no proxy
# in front, the same thing happens — so do not set it "just in case".
TRUST_PROXY="false"

# ENABLE_DEMO_OTP: Set to "true" ONLY in local testing to include demoCode in response.
# MUST be "false" or omitted in production — it returns the live OTP in the
# HTTP response, which defeats the second factor entirely.
ENABLE_DEMO_OTP="true"

# ALLOWED_ORIGINS: Comma-separated trusted origins for CORS (e.g., https://app.watermelon.ai).
# Enforced only when NODE_ENV=production; in development any origin is
# reflected so device testing works. In local development, localhost:5173,
# localhost:3000, and Capacitor schemes are allowed by default.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://localhost,capacitor://localhost"

# ─── Vision service (fastapi_service/) ────────────────────────────────
# VISION_SERVICE_URL: Where server.ts reaches the Python disease classifier.
# If this service is unreachable, /watermelon/disease-detect returns 503.
# It never falls back to a guessed diagnosis.
VISION_SERVICE_URL="http://127.0.0.1:8000"

# VISION_TIMEOUT_MS: How long to wait for a prediction before giving up.
# Cold CPU inference on the first request can take several seconds.
VISION_TIMEOUT_MS="20000"

# Read by fastapi_service/run_api.py and main.py when you start it directly.
VISION_HOST="127.0.0.1"
VISION_PORT="8000"
VISION_CORS_ORIGINS="http://localhost:3000"
# MODEL_PATH: Override the checkpoint location (defaults to fastapi_service/model.pt).
MODEL_PATH=""
